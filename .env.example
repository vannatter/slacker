# Slacker configuration. Copy to .env and fill in.
# Real environment variables override values in this file.
# Quote values that contain spaces.

# Required: Slack app > Basic Information > App Credentials > Signing Secret
SLACK_SIGNING_SECRET=

# Mention the invoking user at the start of public replies ("@dana, ...")
RESPONSE_PREPEND_USER=false

# Show exception messages to the user instead of a generic error
SLACKER_DEBUG=false

# Comma-separated commands to turn off, e.g. "push,say"
SLACKER_DISABLED_PLUGINS=

# weather / weatherext (Open-Meteo, no key needed)
WEATHER_UNITS=fahrenheit          # fahrenheit | celsius
WEATHER_COUNTRY=US                # optional ISO country code to bias zip/city lookups

# listen: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# countdown
COUNTDOWN_DATE=                   # e.g. "2027-12-17 00:00"
COUNTDOWN_LABEL="the big day"
COUNTDOWN_TIMEZONE=America/New_York

# push: name=deploy-hook-url pairs, and the Slack user IDs allowed to trigger them
PUSH_REPOS=                       # e.g. "site=https://api.netlify.com/build_hooks/xxx,api=https://..."
PUSH_ALLOWED_USERS=               # e.g. "U012ABCDEF,U034GHIJKL"
