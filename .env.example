# Slacker Bot Configuration
# Copy this file to .env and fill in your values

# Bot Settings
SLACKER_BOT_NAME=slacker
SLACKER_DEBUG=false
RESPONSE_PREPEND_USER=true

# Slack Configuration
SLACK_HOSTNAME=your-workspace
SLACK_TOKEN=your-slack-token-here
SLACK_CHANNEL=general

# Postback Type: slackbot or webhook
SLACK_POSTBACK_TYPE=webhook

# Slackbot Remote Controls (legacy)
SLACK_API_KEY=your-api-key-here

# Webhook (recommended)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Plugin API Keys
WUNDERGROUND_API_KEY=your-wunderground-api-key
