# Slacker - example nginx server block.
# Only public/ is web-accessible; .env, src/ and vendor/ live outside the docroot.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name slacker.example.com;

    ssl_certificate     /etc/letsencrypt/live/slacker.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/slacker.example.com/privkey.pem;

    root /var/www/slacker/public;
    index index.php;
    server_tokens off;

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;   # adjust to your PHP version
        fastcgi_read_timeout 10s;
    }

    location ~ \.php$ {
        return 404;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name slacker.example.com;
    return 301 https://$host$request_uri;
}
